# Скопируй в .env и заполни. В GitHub Actions то же самое задаётся через Secrets.
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SITE_BASE_URL=            # напр. https://ta-tenders.vercel.app (для кнопок в боте)
HEALTHCHECK_URL=          # dead-man's-switch с healthchecks.io (опционально)

# Supabase (кабинет): Settings → API
SUPABASE_URL=             # https://<project>.supabase.co
SUPABASE_SERVICE_KEY=     # service_role key (СЕКРЕТ! только для пайплайна/CI)

# Поведение
ANALYZE_MAX=40            # потолок LLM-анализов за запуск
TED_ENABLED=1
TENDERWEEK_PAGES=5

# Headless (Playwright): вкл в CI, локально по желанию
HEADLESS_ENABLED=0
HEADLESS_ON=etender,xtxarid,ebrd
